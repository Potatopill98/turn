; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Turn／归乡"
run/main_scene="res://title/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/icon.png"

[autoload]

TurnState="*res://scripts/turn_state.gd"
JournalUI="*res://ui/journal_panel.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=600
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=600
window/mode=0
window/stretch/scale_filter="linear"

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.15, 0.17, 1)
