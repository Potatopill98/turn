func _key(code: Key) -> void:
	var event := InputEventKey.new()
	event.keycode = code
	event.pressed = true
	get_viewport().push_input(event)

func _door(to_scene: String) -> void:
	world.call("debug_door", to_scene)
	await _wait(0.55)
	world.call("debug_advance", 2)
	await _wait(0.25)
	world.call("debug_close_chapter")
	await _wait(0.15)


func _goto_interact(x: float) -> void:
	world.call("debug_goto", x)
	await _wait(0.25)
	world.call("debug_advance", 2)
	await _wait(0.2)
	world.call("debug_interact")
	await _wait(0.25)
	world.call("debug_advance", 2)
	await _wait(0.35)


func _choice(label: String, index: int) -> void:
	var count: int = int(world.call("debug_choice_count"))
	if count <= index:
		_fail(label + " 选项数不足 " + str(count))
		return
	world.call("debug_choose", index)
	await _wait(0.25)


func _evidence(id: String, label: String) -> void:
	if not GameState.has_evidence(id):
		_fail(label + " 不在手记中")
		return
	world.call("debug_choose_evidence_id", id)
	await _wait(0.25)


func _check(expected: int, label: String) -> void:
	var actual: int = int(world.call("debug_step"))
	print("STEP " + label + " expected=" + str(expected) + " actual=" + str(actual))
	if actual != expected:
		_fail(label + " 期望步骤 " + str(expected) + "，实际 " + str(actual))


func _check_phase(expected: int, label: String) -> void:
	var actual: int = GameState.phase
	print("PHASE " + label + " expected=" + str(expected) + " actual=" + str(actual))
	if actual != expected:
		_fail(label + " 期望时段 " + str(expected) + "，实际 " + str(actual))


func _fail(label: String) -> void:
	checks.append(label)
	push_error("LINEAR FLOW FAIL: " + label)


func _wait(seconds: float) -> void:
	await get_tree().create_timer(seconds, true).timeout


func _shot(name: String) -> void:
	if DisplayServer.get_name() == "headless":
		print("SHOT " + name + " (headless skip)")
		return
	var ui_node: Control = world.get("ui") as Control
	if ui_node != null and bool(ui_node.call("is_typing")):
		ui_node.call("advance_dialog")
	await _wait(0.12)
	await RenderingServer.frame_post_draw
	var image: Image = get_viewport().get_texture().get_image()
	image.save_png(OUT_DIR + name + ".png")
	print("SHOT " + name)
